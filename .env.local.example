# LiveKit Cloud (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM — fill whichever you're using; set LLM_PROVIDER in config.py to match
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# STT (Deepgram)
DEEPGRAM_API_KEY=

# TTS (Cartesia)
CARTESIA_API_KEY=

# Persistent memory — only needed when MEMORY_BACKEND = "synap" in config.py
SYNAP_API_KEY=
